NODE_ENV=development
PORT=3100

# 운영 Web -> API 서명 및 운영 Supabase
JWT_SECRET=replace-with-production-api-jwt-secret
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-production-service-role-key

# 개발 Web -> 동일 API 서명 및 개발 Supabase
# 세 값은 모두 함께 설정해야 하며 개발 서명키/URL은 운영 값과 달라야 합니다.
DEV_API_JWT_SECRET=replace-with-development-api-jwt-secret
DEV_SUPABASE_URL=https://your-development-project.supabase.co
DEV_SUPABASE_SERVICE_ROLE_KEY=replace-with-development-service-role-key
# W1이 적용된 DB target만 쉼표로 명시합니다. 운영 W1 적용 전에는 development만 허용합니다.
BUILDING_WRITE_OPERATION_TARGETS=development

ALIGO_API_KEY=replace-with-aligo-api-key
ALIGO_USER_ID=replace-with-aligo-user-id
ALIGO_SENDER_PHONE=replace-with-sender-phone
DEFAULT_SENDER_KEY=replace-with-default-sender-key
DEFAULT_CHANNEL_NAME=통하리

QUEUE_CONCURRENCY=5
QUEUE_MAX_SIZE=100

VWORLD_API_KEY=
VWORLD_API_DOMAIN=www.tonghari.kr
VWORLD_ATTR_REQUEST_INTERVAL_MS=300
# 공공데이터포털에서 제공하는 일반 인증키(Decoding)와 URL 인코딩 인증키(Encoding)를 모두 허용합니다.
DATA_PORTAL_API_KEY=

# VWorld + 공공데이터포털 읽기 전용 GIS MCP (`POST /gis-mcp`)
# 운영 권장: EC2의 owner-only JSON registry를 read-only mount한 container 절대 경로입니다.
# 비활성 상태에서는 아래 세 인증 변수를 정의하지 않습니다. 활성화할 때 정확히 하나만 주석 해제합니다.
# GIS_MCP_TOKEN_REGISTRY_FILE=/run/secrets/tonghari-gis-mcp/clients.json
# 최초 file registry 이전과 로컬 개발용 JSON fallback입니다. raw bearer는 넣지 않습니다.
# npm run gis:mcp:token -- client-generate --client-id <lowercase-slug>
# GIS_MCP_TOKEN_REGISTRY_JSON=
# 하위 호환 단일 client 전용입니다. 다른 registry source와 동시에 설정하면 MCP가 비활성화됩니다.
# GIS_MCP_TOKEN_SHA256=
# Caddy만 보유하는 별도 raw proxy secret의 SHA-256 digest입니다.
GIS_MCP_PROXY_TOKEN_SHA256=
# hostname만 쉼표로 구분합니다. scheme, port, path, wildcard는 금지합니다.
GIS_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Origin을 보내는 서버 간 client만 설정하며 브라우저 CORS 허용값이 아닙니다.
GIS_MCP_ALLOWED_ORIGINS=
GIS_MCP_REQUESTS_PER_MINUTE=20
GIS_MCP_GLOBAL_REQUESTS_PER_MINUTE=40
GIS_MCP_REQUEST_DEADLINE_MS=45000
GIS_MCP_MAX_CONCURRENCY=2
GIS_MCP_MAX_QUEUE=4
# 운영 canary 대상 allowlist가 별도 구현·승인되기 전까지 반드시 false를 유지합니다.
LAND_AREA_SYNC_ENABLED=false
# databaseTarget:unionUuid:anchorPnu 형식. 여러 PNU는 쉼표로 구분하며 wildcard는 금지합니다.
LAND_AREA_SYNC_ALLOWED_TARGETS=

# 기본 비활성. 계약/실인증 검증 전에는 true로 변경하지 않습니다.
KG_INICIS_ENABLED=false
# production 또는 development. JWT 서명키로 확정한 대상과 일치해야 합니다.
KG_INICIS_DATABASE_TARGET=
KG_INICIS_MID=
KG_INICIS_API_KEY=
# 별도 발급된 UTF-8 16바이트 IV. Base64 값이 아닙니다.
KG_INICIS_SEED_IV=
# https://<web-origin>/api/identity-verification/callback (뒤에 / 금지)
# 생성되는 success/fail URL 전체가 128바이트 이하여야 합니다.
KG_INICIS_CALLBACK_BASE_URL=
# 계약으로 확인한 reqSvcCd=03 기관 코드만 쉼표로 구분합니다.
KG_INICIS_ID_PROVIDERS=

# 현행 정비사업 법률 MCP
# LAW_API_OC는 open.law.go.kr에 이 API 서버의 고정 IP/도메인을 등록한 OC입니다.
LAW_API_OC=
# 운영 권장: EC2의 owner-only JSON registry를 read-only mount한 container 절대 경로입니다.
# file / JSON / legacy digest 중 하나만 비어 있지 않게 설정합니다.
LEGAL_MCP_TOKEN_REGISTRY_FILE=
# 최초 file registry 이전과 로컬 개발용 JSON fallback입니다. 원문 token은 넣지 않습니다.
# npm run legal:mcp:token -- client-generate --client-id <lowercase-slug>
LEGAL_MCP_TOKEN_REGISTRY_JSON=
# 하위 호환 단일 client 전용입니다. 다른 registry source와 동시에 설정하면 MCP가 비활성화됩니다.
LEGAL_MCP_TOKEN_SHA256=
# TLS reverse proxy만 보유하는 별도 raw token의 SHA-256 digest입니다.
LEGAL_MCP_PROXY_TOKEN_SHA256=
# MCP host가 받은 근거 패킷의 변조를 막는 별도 256-bit 이상 hex HMAC key입니다.
LEGAL_MCP_PACKET_SIGNING_KEY=
# hostname만 쉼표로 구분합니다. 포트, scheme, path는 넣지 않습니다.
LEGAL_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# 서버 간 MCP client가 Origin header를 보낼 때만 hostname을 설정합니다. 브라우저 CORS/preflight는 지원하지 않습니다.
LEGAL_MCP_ALLOWED_ORIGINS=
# bearer별/프로세스 전체 분당 research 상한입니다.
LEGAL_MCP_RESEARCH_REQUESTS_PER_MINUTE=6
LEGAL_MCP_RESEARCH_GLOBAL_REQUESTS_PER_MINUTE=12
# 1회 전체 조사 deadline과 프로세스 전역 admission 상한입니다.
LEGAL_MCP_RESEARCH_DEADLINE_MS=45000
LEGAL_MCP_RESEARCH_MAX_CONCURRENCY=2
LEGAL_MCP_RESEARCH_MAX_QUEUE=4
